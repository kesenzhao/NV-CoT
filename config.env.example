# Copy to config.env, edit, then: source config.env (on BOTH nodes).
# Use an absolute shared filesystem directory, identical on both nodes.
export RUN_DIR=/shared/deepeyes/runs/qwen3vl8b
export EVAL_MODEL=/shared/deepeyes/assets/Qwen3-VL-8B-Instruct
export RAW_DATA=/shared/deepeyes/assets/DeepEyes-Datasets-47k
export VSTAR_DIR=/shared/deepeyes/assets/vstar_bench
export MASTER_ADDR=REPLACE_WITH_NODE0_REACHABLE_IP
export MASTER_PORT=29657
# OpenAI-compatible chat API, or bearer-authenticated Gemini generateContent API.
export JUDGE_BACKEND=openai
export JUDGE_BASE_URL=https://YOUR_PROVIDER/v1
export LLM_AS_A_JUDGE_MODEL=YOUR_JUDGE_MODEL
# Provide JUDGE_API_KEY through the environment; do not commit it.
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Optional self-hosted 72B JUDGE (reward scoring; not a KL reference policy).
# On the dedicated judge server:
# export JUDGE_MODEL_DIR=/shared/deepeyes/assets/Qwen2.5-72B-Instruct
# export JUDGE_PORT=18901
# On BOTH training nodes, override the remote judge settings above:
# export JUDGE_BACKEND=openai
# export JUDGE_BASE_URL=http://JUDGE_SERVER_IP:18901/v1
# export LLM_AS_A_JUDGE_MODEL=Qwen2.5-72B-Instruct
# export JUDGE_API_KEY=EMPTY  # only for a trusted, unauthenticated local service
